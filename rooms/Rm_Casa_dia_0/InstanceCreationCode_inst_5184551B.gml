        [
            "Observar", 
            [
                [2, 0, "(Esse lugar me causa calafrios...)"],
                [2, 0, "(Imaginar esses corpos cobertos aí embaixo da janela me lembra de como tudo deu errado.)"],
                [2, 0, "(Pelo menos agora eu consigo evitar que isso aconteça.)"]
            ]
        ],
        
        [
            "Observar", 
