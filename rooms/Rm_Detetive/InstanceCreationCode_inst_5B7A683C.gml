if (global.historia == 4) {
    dialogos = [
        [
            "Observar", 
            [
                [1, 0, "A serpente engolindo a própria cauda."],
                [1, 0, "Ouroboros... Onde será que começa?"]
            ]
        ],
        [
            "Observar", 
            [
                [1, 0, "Um ciclo de mortes, culpa e paradoxos que se repetem de novo e de novo..."],
                [1, 0, "Ouroboros... Onde será que termina?"]
            ]
        ]
    ];
}
else if (global.historia == 2.5) {
    dialogos = [
        [
            "Investigar", 
            [
                [1, 0, "Eu queria que esse relógio avançasse no tempo, para que isso acabasse logo..."]
            ]
        ]
    ];
} else if (global.historia == 1.4) {
    dialogos = [
        [
            "Investigar", 
            [
                [1, 0, "Engraçado... depois de sonhar tanto com o tempo parando e voltando, olhar para um relógio quebrado me dá um frio na espinha."],
                [1, 0, "Talvez o tempo realmente tenha parado para ele."]
            ]
        ],
        [
            "Examinar", 
            [
                [1, 0, "Acho que vou deixá-lo quebrado por um bom tempo. Melhor não mexer com coisas que eu não entendo."]
            ]
        ]
    ];
} else {
    
    dialogos = [
        [
            "Investigar",
            [
                [1, 0, "Esses relógios nunca funcionam de verdade... Você compra e eles só duram alguns meses, depois disso você não quer mais se livrar deles porque viram uma boa decoração."]
            ]
        ],
        [
            "Examinar",
            [
                [1, 0, "Acho que preciso de decorações melhores."]
            ]
        ]
    ];
}