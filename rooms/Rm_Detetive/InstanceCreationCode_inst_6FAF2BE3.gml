if (global.historia == 1.4) {
    dialogos = [
        [
            "Observar", 
            [
                [1, 0, "Ei, espera... eu acho que conheço aquele cara... mas..."],
                [1, 0, "Eu vi ele morto! Não vi? Não era um sonho?"],
                [1, 0, "Então... aquilo tudo não era um sonho? Que doidera!"]
            ]
        ]
    ];
} else {
    instance_destroy();
}